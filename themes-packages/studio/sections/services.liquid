<section class="band" id="services">
  <h2>Services</h2>
  {%- if section.services.size == 0 -%}
  <p class="empty">The chair is always busy — message us for current prices.</p>
  {%- else -%}
  <ul class="svc">
    {%- for s in section.services -%}
    <li>
      <div>
        <span class="s-name">{{ s.name }}</span>
        {%- if s.description %}<span class="s-desc">{{ s.description }}</span>{% endif -%}
      </div>
      <div class="s-right">
        <span class="s-price">{% if s.price %}{{ s.price }}{% else %}from consult{% endif %}</span>
        {%- if s.waLink %}<a class="s-book" href="{{ s.waLink }}">Book</a>{% endif -%}
      </div>
    </li>
    {%- endfor -%}
  </ul>
  {%- endif -%}
</section>
