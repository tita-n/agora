<section class="band"><h2>Where</h2>
  <p class="wide">
    {%- if business.address %}{{ business.address }}{% if business.mapsUrl %} · <a href="{{ business.mapsUrl }}">Map</a>{% endif %}<br />{% endif -%}
    {%- if business.contactPhone %}<a href="tel:{{ business.contactPhone }}">{{ business.contactPhone }}</a>{% endif -%}
    {%- if business.contactEmail %} · <a href="mailto:{{ business.contactEmail }}">Email</a>{% endif -%}
  </p>
</section>
