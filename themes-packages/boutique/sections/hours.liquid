{%- if hours.size > 0 -%}
<section class="band hours">
  <h2>Opening hours</h2>
  <dl class="hlist">
    {%- for h in hours -%}
    <div class="hrow"><dt>{{ h.day }}</dt><dd>{% if h.closed %}Closed{% else %}{{ h.open }}–{{ h.close }}{% endif %}</dd></div>
    {%- endfor -%}
  </dl>
</section>
{%- endif -%}
