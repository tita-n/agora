<section class="band" id="catalog">
  <h2>The collection</h2>
  {%- if filters.categories.size > 1 -%}
  <nav class="chips" aria-label="Categories">
    <a class="chip{% unless filters.active %} chip-on{% endunless %}" href="?">All</a>
    {%- for c in filters.categories -%}
    <a class="chip{% if filters.active == c %} chip-on{% endif %}" href="?category={{ c | url_encode }}">{{ c }}</a>
    {%- endfor -%}
  </nav>
  {%- endif -%}
  {%- if section.products.size == 0 -%}
  <p class="empty">Nothing here yet — check back soon.</p>
  {%- else -%}
  <ul class="grid">
    {%- for p in section.products -%}
    {%- if settings.show_out_of_stock or p.inStock -%}
    <li class="card">
      <a class="card-link" href="{{ p.url }}">
        {%- if p.imageUrls.size > 0 -%}
        <img src="{{ p.imageUrls[0] | image_url }}" alt="{{ p.name }}" loading="lazy" width="600" height="750" />
        {%- else -%}
        <span class="card-missing" aria-hidden="true"></span>
        {%- endif -%}
        <span class="card-body">
          <span class="card-name">{{ p.name }}</span>
          <span class="card-price">{% if p.price %}{{ p.price }}{% else %}Price on request{% endif %}</span>
          {%- unless p.inStock %}<span class="badge badge-out">Out of stock</span>{% endunless -%}
        </span>
      </a>
    </li>
    {%- endif -%}
    {%- endfor -%}
  </ul>
  {%- if pagination.pages > 1 -%}
  <nav class="pager" aria-label="More pieces">
    {%- if pagination.prevHref %}<a href="{{ pagination.prevHref }}">&larr; Newer</a>{% endif -%}
    <span>Page {{ pagination.page }} of {{ pagination.pages }}</span>
    {%- if pagination.nextHref %}<a href="{{ pagination.nextHref }}">Older &rarr;</a>{% endif -%}
  </nav>
  {%- endif -%}
  {%- endif -%}
</section>
