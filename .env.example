# Database (PostgreSQL connection string — works with Neon or any Postgres provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Vercel Blob — get from `vercel blob` dashboard or `npx vercel blob` CLI
BLOB_READ_WRITE_TOKEN=""

# NextAuth
NEXTAUTH_SECRET="generate-a-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# The canonical root domain (no subdomain). Used by middleware to split subdomains.
# Local: "agora.test" (edit /etc/hosts). Production: your apex domain, e.g. "agora.com".
# NOTE: .vercel.app does NOT support wildcard tenant subdomains — see README.
ROOT_DOMAIN="agora.test"

# ── Payment providers (Phase 1.5) ─────────────────────────────────────────
# The whole manual/paystack switch: "manual" (bank transfer + admin confirm,
# ACTIVE) or "paystack" (hosted checkout + webhooks). Default if unset: manual.
PAYMENT_PROVIDER="manual"

# Manual provider — REAL bank details, supplied by the platform owner,
# NEVER committed and never invented. Production boot fails if the manual
# provider is active and any of these is unset.
MANUAL_BANK_NAME=""
MANUAL_BANK_ACCOUNT_NAME=""
MANUAL_BANK_ACCOUNT_NUMBER=""

# Paystack (only needed when PAYMENT_PROVIDER=paystack). Test key
# (sk_test_…) for local/dev; production builds with paystack active FAIL AT
# BOOT without it — never a placeholder, never committed.
PAYSTACK_SECRET_KEY=""

# Vercel Cron protection — Vercel sends it automatically to /api/cron/*.
# Required in production (vercel.json ships enabled crons). openssl rand -hex 16
CRON_SECRET=""

# Renewal-reminder email via Resend. OPTIONAL by design: unset means the cron
# job logs the reminder instead of sending it (feature must not block on email).
# RESEND_API_KEY="re_…"
# RESEND_FROM_EMAIL="Agora <billing@yourdomain.example>"

# Test seam ONLY — point at a local mock to exercise the Paystack client
# without network. Must be unset in production.
# PAYSTACK_API_BASE_URL="http://127.0.0.1:4571"

# Node environment
NODE_ENV="development"

# Optional: enable extra logging
# DEBUG="*"
# ── Platform APIs (Phase 2) ──────────────────────────────────────────────
# Vercel team access token (Settings → Account Settings → Tokens, "Vercel
# Authentication Token" scoped to the team) + this project's id (Settings →
# Project Settings → General, or the URL: prj_…). Used server-side ONLY for:
#   - per-business bandwidth in the usage-snapshot cron (Analytics API —
#     a PRO-PLAN endpoint; on lower plans those two fields keep their last
#     known/manual values and the cron log says so explicitly)
#   - adding + verifying business custom domains (project Domains API)
# Unset by design = everything still runs; storage usage is measured from
# the Blob store via BLOB_READ_WRITE_TOKEN regardless.
# VERCEL_ACCESS_TOKEN=vca_...
# VERCEL_PROJECT_ID=prj_...
# Test seam for unit tests only — never set in production.
# VERCEL_API_BASE_URL=http://localhost:0
