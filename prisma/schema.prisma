generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  business_owner
  developer
  admin
}

model Business {
  id         String   @id @default(cuid())
  name       String
  subdomain  String   @unique
  customDomain String? @unique
  ownerId    String
  themeId    String?
  logoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id])
  theme      Theme?   @relation(fields: [themeId], references: [id])

  // No @@index([subdomain]) — @unique already provides the index (M-7).
  @@index([ownerId])
  @@index([themeId]) // M-6: theme usage / revenue-split lookups scan this
}

model Theme {
  id         String     @id @default(cuid())
  name       String
  devId      String
  price      Int        // in kobo (smallest currency unit) to avoid float issues
  category   String
  createdAt  DateTime   @default(now())
  dev        User       @relation(fields: [devId], references: [id])
  businesses Business[]

  @@index([devId])
  @@index([category])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  role      Role       @default(business_owner) // M-8: enum, not free string
  createdAt DateTime   @default(now())
  businesses Business[]
  themes     Theme[]

  // No @@index([email]) — @unique already provides the index (M-7).
  @@index([role])
}